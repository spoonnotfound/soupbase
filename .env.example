# byok_only | site_only | both
AI_ACCESS_MODE=byok_only
# Service used for hosted access: vercel | typesafe | openrouter
AI_SITE_PROVIDER=vercel
# Only the selected service's server key is required in site_only/both.
# Players choose their own service separately in BYOK mode. Never commit real keys.
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
# Vercel Neon integration injects this automatically. Leave empty for local PGlite.
DATABASE_URL=
